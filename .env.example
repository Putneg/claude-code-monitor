# Absolute path to the Claude Code config directory that contains "projects".
# Windows example: C:/Users/<user>/.claude   macOS/Linux example: /home/<user>/.claude
CLAUDE_HOME=C:/Users/<user>/.claude

# IANA time zone for daily buckets: set your own, e.g. Europe/Kyiv or America/New_York. Changing it later is safe: stored days are recomputed.
TZ=UTC

# Host port (published on 127.0.0.1 only).
MONITOR_PORT=8739

# How often transcripts are rescanned, in seconds (10-3600).
SCAN_INTERVAL_SEC=60

LOG_LEVEL=info

# Extra hostnames the dashboard answers besides localhost, 127.0.0.1 and [::1], comma-separated, for example the name
# an authenticating reverse proxy forwards. This is not access control: the service has no authentication.
# ALLOWED_HOSTS=monitor.example.lan

# Every variable in this file is also passed to the container (see the README table),
# except the container paths and port, which docker-compose.yml pins. Optional example:
# PRICING_REFRESH_HOURS=24
